{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "CLAUDE.md",
    ".claude/RESPONSIBLE_AI_USE.md"
  ],
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "ask"
